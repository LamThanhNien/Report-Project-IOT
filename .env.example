APP_NAME=AIFOM API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Copy this file to .env for local development.
# Never commit .env or any file containing real secrets.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=aifom
POSTGRES_USER=aifom
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

DATABASE_URL=postgresql+psycopg2://aifom:REPLACE_ME_WITH_STRONG_PASSWORD@postgres:5432/aifom
APP_DATABASE_URL=postgresql+psycopg2://aifom_app:REPLACE_ME_WITH_STRONG_PASSWORD@postgres:5432/aifom

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_USERNAME=aifom-api
MQTT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
MQTT_CLIENT_ID=aifom-api-subscriber
# MQTT TLS configuration – enable in production (true) and provide paths to CA, server cert, and key.
# Set MQTT_TLS_ENABLED=true in production. For local dev you may keep it false.
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_CERT=/run/secrets/mqtt/ca.crt
MQTT_TLS_CERTFILE=/run/secrets/mqtt/server.crt
MQTT_TLS_KEYFILE=/run/secrets/mqtt/server.key
MQTT_TLS_INSECURE=false

# Mosquitto password file users (for docker-entrypoint.sh)
MQTT_ADMIN_USER=aifom-api
MQTT_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
MQTT_DEVICE_USER=aifom_device
# IMPORTANT: Must match MQTT_PASS in firmware (default: aifom_device_pass).
MQTT_DEVICE_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# Device-facing network targets for physical ESP32 demos.
# ESP32 discovers MQTT via mDNS service discovery. Do not hardcode the PC IP in firmware.
DEVICE_MQTT_HOST=aifom.local
DEVICE_MQTT_PORT=1883

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aifom_minio
MINIO_SECRET_KEY=REPLACE_ME_WITH_STRONG_PASSWORD
MINIO_BUCKET_FIRMWARE=firmware
MINIO_SECURE=false
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

FIRMWARE_MAX_SIZE_MB=32

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host port mappings (used by docker-compose and Vite proxy)
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# Device-facing API URL used in OTA payloads (ESP32 download URL).
DEVICE_API_BASE_URL=http://aifom.local:8000
# Backward-compatible alias accepted by backend config.
AIFOM_PUBLIC_BASE_URL=http://aifom.local:8000

# Arduino CLI — set to the path of the arduino-cli binary to enable server-side .ino compilation.
# Source compilation is disabled by default because it runs an external compiler process.
ENABLE_SOURCE_FIRMWARE_COMPILE=false
ALLOW_HOST_SOURCE_FIRMWARE_COMPILE=false
SOURCE_FIRMWARE_ALLOWED_FQBNS=esp32:esp32:esp32
# Example: ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli
ARDUINO_CLI_PATH=

# Logging — control backend log verbosity
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_HTTP: log one line per HTTP request     (default: true)
# LOG_HEALTHCHECKS: include /health /ready    (default: false)
AIFOM_LOG_LEVEL=INFO
AIFOM_LOG_HTTP=true
AIFOM_LOG_HEALTHCHECKS=false

# ── JWT (REQUIRED) ──────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Backend REFUSES to start if this is missing or set to an insecure default.
JWT_SECRET=REPLACE_ME_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_WITH_DIFFERENT_64_CHAR_HEX_REFRESH_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# Keep true for local CLI/test backward compatibility. Set false in production.
AUTH_LEGACY_TOKEN_RESPONSE=true

# ── OTA download tokens ─────────────────────────────────────────────────────
# Secret for signing short-lived firmware download tokens.
OTA_TOKEN_SECRET=REPLACE_ME_WITH_RANDOM_STRING
OTA_TOKEN_EXPIRE_MINUTES=30

# ── Device provisioning ─────────────────────────────────────────────────────
# Shared secret that devices must present during self-registration.
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
# Set to empty string to DISABLE device self-registration (admin must pre-register).
DEVICE_PROVISIONING_SECRET=REPLACE_ME_WITH_RANDOM_STRING

# Default admin credentials seeded by `make seed-admin` (development only).
ADMIN_SEED_EMAIL=admin@aifom.local
ADMIN_SEED_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# Development-only frontend login helper text. Leave unset in production builds.
VITE_DEMO_ADMIN_EMAIL=REPLACE_ME_WITH_DEMO_ADMIN_EMAIL
VITE_DEMO_ADMIN_PASSWORD=REPLACE_ME_WITH_DEMO_ADMIN_PASSWORD
VITE_DEMO_ADMIN_PASSWORD_HINT=REPLACE_ME_WITH_DEMO_ADMIN_PASSWORD_HINT
VITE_DEMO_TENANT_EMAIL=REPLACE_ME_WITH_DEMO_TENANT_EMAIL
VITE_DEMO_TENANT_PASSWORD=REPLACE_ME_WITH_DEMO_TENANT_PASSWORD
VITE_DEMO_TENANT_PASSWORD_HINT=REPLACE_ME_WITH_DEMO_TENANT_PASSWORD_HINT

# Launcher behavior (run-aifom.bat / run-aifom.ps1)
# Set AIFOM_AUTO_SEED_DEMO=1 for dedicated local demo data and accounts after startup.
AIFOM_AUTO_SEED_DEMO=0
# Optional timeout tuning to reduce startup wait in launcher status checks.
AIFOM_API_HEALTH_TIMEOUT_SECONDS=15
AIFOM_API_READY_TIMEOUT_SECONDS=15
# Ed25519 PEM private key used by the explicit admin firmware-signing action.
# Development generates a persistent key under .local/keys when this is empty.
# Production must set and mount an explicit read-only key; never commit it.
FIRMWARE_SIGNING_PRIVATE_KEY_PATH=
FIRMWARE_SIGNING_KEY_ID=
VITE_DEMO_VIEWER_EMAIL=REPLACE_ME_WITH_DEMO_VIEWER_EMAIL
VITE_DEMO_VIEWER_PASSWORD=REPLACE_ME_WITH_DEMO_VIEWER_PASSWORD
VITE_DEMO_VIEWER_PASSWORD_HINT=REPLACE_ME_WITH_DEMO_VIEWER_PASSWORD_HINT
AUTO_OPEN_API_LOGS=1
AUTO_OPEN_MQTT_LOGS=1
