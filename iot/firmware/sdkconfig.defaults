CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# Larger main task stack for cJSON + MQTT publish.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# AIFOM defaults (non-secret). Override Wi-Fi creds in sdkconfig.defaults.local
# or via menuconfig. See sdkconfig.defaults.example.
CONFIG_AIFOM_WIFI_SSID=""
CONFIG_AIFOM_WIFI_PASSWORD=""
CONFIG_AIFOM_WIFI_MAXIMUM_RETRY=10
CONFIG_AIFOM_ENABLE_MDNS_DISCOVERY=y
CONFIG_AIFOM_MDNS_HOST="aifom.local"
CONFIG_AIFOM_MQTT_HOST="aifom.local"
CONFIG_AIFOM_MQTT_SCHEME="mqtt"
CONFIG_AIFOM_MQTT_PORT=1883
CONFIG_AIFOM_MQTT_USERNAME=""
CONFIG_AIFOM_MQTT_PASSWORD=""
CONFIG_AIFOM_API_PORT=8000
CONFIG_AIFOM_FALLBACK_API_BASE_URL="http://aifom.local:8000"
CONFIG_AIFOM_DEVICE_UID=""
CONFIG_AIFOM_PROVISIONING_TOKEN=""
CONFIG_AIFOM_TELEMETRY_INTERVAL_MS=5000
CONFIG_AIFOM_HEARTBEAT_INTERVAL_MS=15000

# OTA / rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# esp_https_ota / esp_http_client use mbedtls; we use plain HTTP for the lab
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Set this in your build to identify the image; defaults to PROJECT_VER
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# Enable mDNS query support in LWIP for HTTP Client
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
