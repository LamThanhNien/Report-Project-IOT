APP_NAME=AIFOM API
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=aifom
POSTGRES_USER=aifom
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg2://aifom:REPLACE_ME_WITH_STRONG_PASSWORD@postgres:5432/aifom

MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_HOST_PORT=8883
MQTT_USERNAME=aifom-api
MQTT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
MQTT_CLIENT_ID=aifom-api-subscriber
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_CERT=/mosquitto/certs/ca.crt
MQTT_TLS_CERTFILE=/mosquitto/certs/server.crt
MQTT_TLS_KEYFILE=/mosquitto/certs/server.key
MQTT_TLS_INSECURE=false

MQTT_ADMIN_USER=aifom-api
MQTT_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
# Host path to a Mosquitto password file containing aifom_backend plus one
# unique username per production device. Device usernames must match the
# identifier used by the production ACL topic patterns.
MQTT_PASSWORD_FILE=./mosquitto/config/passwd.prod

DEVICE_MQTT_HOST=your-mqtt.example.com
DEVICE_MQTT_PORT=8883

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aifom_minio
MINIO_SECRET_KEY=REPLACE_ME_WITH_STRONG_PASSWORD
MINIO_BUCKET_FIRMWARE=firmware
MINIO_SECURE=true

CORS_ALLOW_ORIGINS=https://your-ui.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_LEGACY_TOKEN_RESPONSE=false

DEVICE_API_BASE_URL=https://your-api.example.com
AIFOM_PUBLIC_BASE_URL=https://your-api.example.com

FIRMWARE_MAX_SIZE_MB=32
ENABLE_SOURCE_FIRMWARE_COMPILE=false
SOURCE_FIRMWARE_ALLOWED_FQBNS=esp32:esp32:esp32
ARDUINO_CLI_PATH=

AIFOM_LOG_LEVEL=INFO
AIFOM_LOG_HTTP=true
AIFOM_LOG_HEALTHCHECKS=false

# Generate two independent values with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_HEX_CHAR_REFRESH_SECRET
# Optional bounded legacy refresh-token window (ISO-8601 with timezone).
# JWT_MIGRATION_DEADLINE=2026-06-29T00:00:00Z
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Generate independently with: python -c "import secrets; print(secrets.token_hex(32))"
OTA_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHAR_OTA_SECRET
OTA_TOKEN_EXPIRE_MINUTES=15
OTA_TOKEN_EXPIRE_MINUTES=30
DEVICE_PROVISIONING_SECRET=
