# AIFOM Tester Configuration
# Copy this to .env and fill in real values

# Backend API
API_BASE_URL=http://localhost:8000

# Frontend (for Playwright E2E)
FRONTEND_URL=http://localhost:5173

# Admin credentials (must match your seed_admin.py ADMIN_SEED_* env vars)
ADMIN_EMAIL=REPLACE_ME_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_ME_WITH_ADMIN_PASSWORD

# Tenant credentials (must match your seed_tenant_demo.py TENANT_USERS)
TENANT1_EMAIL=REPLACE_ME_WITH_TENANT1_EMAIL
TENANT1_PASSWORD=REPLACE_ME_WITH_TENANT1_PASSWORD
TENANT2_EMAIL=REPLACE_ME_WITH_TENANT2_EMAIL
TENANT2_PASSWORD=REPLACE_ME_WITH_TENANT2_PASSWORD

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=REPLACE_ME_WITH_MQTT_USERNAME
MQTT_PASSWORD=REPLACE_ME_WITH_MQTT_PASSWORD
MQTT_TIMEOUT=10

# Device provisioning token (must match backend DEVICE_PROVISIONING_SECRET)
DEVICE_PROVISIONING_TOKEN=REPLACE_ME_WITH_DEVICE_PROVISIONING_TOKEN

# HTTP timeout (seconds)
REQUEST_TIMEOUT=30
