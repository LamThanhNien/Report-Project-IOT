APP_NAME=AIFOM API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=aifom
POSTGRES_USER=aifom
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg2://aifom:REPLACE_ME_WITH_STRONG_PASSWORD@postgres:5432/aifom
APP_DATABASE_URL=postgresql+psycopg2://aifom_app:REPLACE_ME_WITH_STRONG_PASSWORD@postgres:5432/aifom
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_USERNAME=aifom-api
MQTT_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
MQTT_CLIENT_ID=aifom-api-subscriber
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
MQTT_TLS_INSECURE=false
DEVICE_MQTT_HOST=aifom.local
DEVICE_MQTT_PORT=1883
DEVICE_API_BASE_URL=http://aifom.local:8000
AIFOM_PUBLIC_BASE_URL=http://aifom.local:8000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aifom_minio
MINIO_SECRET_KEY=REPLACE_ME_WITH_STRONG_PASSWORD
MINIO_BUCKET_FIRMWARE=firmware

# JWT -- REQUIRED: Backend refuses to start with insecure defaults.
# Generate two independent values with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_HEX_CHAR_REFRESH_SECRET
# Optional bounded legacy refresh-token window (ISO-8601 with timezone).
# It must be no later than AUTH_REFRESH_COOKIE_DAYS from application startup.
# JWT_MIGRATION_DEADLINE=2026-06-29T00:00:00Z
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_LEGACY_TOKEN_RESPONSE=true

# OTA download tokens
# Generate independently with: python -c "import secrets; print(secrets.token_hex(32))"
OTA_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHAR_OTA_SECRET
OTA_TOKEN_EXPIRE_MINUTES=15
OTA_TOKEN_EXPIRE_MINUTES=30

# Device provisioning
DEVICE_PROVISIONING_SECRET=REPLACE_ME_WITH_RANDOM_STRING

# Arduino source compilation is disabled by default because it runs an external compiler process.
ENABLE_SOURCE_FIRMWARE_COMPILE=false
ALLOW_HOST_SOURCE_FIRMWARE_COMPILE=false
SOURCE_FIRMWARE_ALLOWED_FQBNS=esp32:esp32:esp32
ARDUINO_CLI_PATH=
# Ed25519 PEM private key used by the explicit admin firmware-signing action.
# Never commit the key itself; mount it read-only in production.
# Empty in development generates .local/keys/firmware-signing-ed25519.pem.
# Production must set an explicit read-only Ed25519 PEM path.
FIRMWARE_SIGNING_PRIVATE_KEY_PATH=
FIRMWARE_SIGNING_KEY_ID=

# ---------------------------------------------------------------------------
# Readiness probe configuration
# See backend/README.md for full documentation (Observability section).
# ---------------------------------------------------------------------------

# Whether MQTT connectivity is required for /ready to return 200.
# Set true in production if the API cannot function without the broker.
REQUIRE_MQTT_FOR_READINESS=false

# Whether MinIO connectivity is required for /ready to return 200.
# Set true if firmware upload/download is critical for the deployment.
REQUIRE_MINIO_FOR_READINESS=false

# Per-component readiness probe timeout in seconds.
# A hung DB, socket, MinIO, or Alembic operation is cut off after this.
# Must be < READINESS_OVERALL_TIMEOUT.
READINESS_COMPONENT_TIMEOUT=5

# Overall readiness budget in seconds (all components combined).
# /ready returns 503 immediately if this is exceeded.
READINESS_OVERALL_TIMEOUT=20

# Readiness cache TTL in seconds.
# Avoids hammering dependencies on every Kubernetes liveness/readiness ping.
# Set 0 to disable caching (not recommended in production).
READINESS_CACHE_TTL=10

# ---------------------------------------------------------------------------
# Logging and observability
# ---------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
AIFOM_LOG_LEVEL=INFO

# Log one line per HTTP request.
AIFOM_LOG_HTTP=true

# Include /health, /ready, /metrics in HTTP access logs (noisy -- keep false).
AIFOM_LOG_HEALTHCHECKS=false
